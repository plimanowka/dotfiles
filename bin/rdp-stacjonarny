#!/usr/bin/env bash
# rdp-stacjonarny — remote GNOME session on the home Linux box (GNOME Remote Login) via FreeRDP.
#
# Why FreeRDP, not Microsoft Windows App: GNOME Remote Login hands the connection over to the
# login screen with one-time credentials (server redirection); Windows App for macOS re-sends the
# user's password instead and fails ("Credentials did not work", MIC verification failed in the
# box journal). FreeRDP follows the redirection.
#
# Keys: Toshy on the box only remaps physical keyboards, RDP input bypasses it. So the Mac side
# maps left Cmd -> Ctrl (copy/paste/save as on Linux). Ctrl stays Ctrl (terminal/TUI keys: Ctrl+C,
# Ctrl+R, Ctrl+Q), right Cmd stays Super (GNOME overview), Option stays Alt. Workspace switching and
# Option word moves come from the FreeRDP-only Karabiner rule (macos/karabiner.json), because macOS
# keeps Ctrl+arrows for its own Spaces.
# Window, not full screen: +dynamic-resolution makes it resizable/maximizable and re-sends the
# resolution on resize and when the window moves to another display; the scale follows that
# display (Retina 200 %, plain monitor 100 %) because no /scale-desktop override is given.
# FreeRDP hotkeys use RIGHT Shift: RShift+Enter full screen on/off, RShift+R resizable,
# RShift+G release keyboard grab, RShift+D disconnect, RShift+M minimize.
#
# /ipv4: after a network drop mDNS also returns the link-local IPv6 address, which FreeRDP
# fails on ("Couldn't get socket ip address"); prefer the A record.
#
# Sound: /sound plays the box audio on the Mac (rdpsnd, macOS backend built into Homebrew freerdp).
#
# Password: macOS Keychain, item "stacjonarny-rdp" (add once:
#   security add-generic-password -a pawel -s stacjonarny-rdp -w
# ). Fed on stdin so it never shows up in `ps`.
set -euo pipefail

HOST="${RDP_HOST:-stacjonarny.local}"
USER_NAME="${RDP_USER:-pawel}"

# --app: build ~/Applications/RDP Stacjonarny.app (Spotlight, Launchpad, Dock) that runs this script.
if [[ "${1:-}" == "--app" ]]; then
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    app="$HOME/Applications/RDP Stacjonarny.app"
    mkdir -p "$HOME/Applications"
    rm -rf "$app"
    # `do shell script` gets a bare PATH; add Homebrew so sdl-freerdp is found.
    osacompile -o "$app" -e "do shell script \"export PATH=/opt/homebrew/bin:/usr/local/bin:\$PATH; '$self' >/dev/null 2>&1\""
    echo "gotowe: $app"
    exit 0
fi

command -v sdl-freerdp >/dev/null || { echo "brak sdl-freerdp: brew install freerdp" >&2; exit 1; }

args=(/v:"$HOST" /ipv4 /u:"$USER_NAME" /cert:tofu +dynamic-resolution /size:90% /gfx:AVC444 +clipboard /sound
      /kbd:remap:347=29)
# RDP scancodes in decimal: 347=LWin 29=LCtrl (sdl-freerdp /list:kbd-scancode).
# FreeRDP 3 rejects remap entries longer than 10 chars (cmdline.c check_kbd_remap_valid), so no 0x015b=0x001d.

LOG="$HOME/Library/Logs/rdp-stacjonarny.log"

if pass=$(security find-generic-password -a "$USER_NAME" -s stacjonarny-rdp -w 2>/dev/null); then
    # Detached: the terminal stays free and closing it does not drop the session.
    printf '%s\n' "$pass" | nohup sdl-freerdp "${args[@]}" /from-stdin "$@" >"$LOG" 2>&1 &
    echo "FreeRDP w tle, log: $LOG"
else
    # No stored password: stay in the foreground, FreeRDP asks for it in this terminal.
    echo "brak hasła w Pęku kluczy (security add-generic-password -a $USER_NAME -s stacjonarny-rdp -w) — pytam ręcznie" >&2
    exec sdl-freerdp "${args[@]}" "$@"
fi
